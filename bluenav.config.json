{
  "browserName": "BlueNav",
  "version": "1.0.0",
  "branding": {
    "style": "minimal-dark-pro",
    "theme": "obsidian",
    "primaryColor": "#FFFFFF",
    "backgroundColorDark": "#09090B",
    "surfaceColorDark": "#131316",
    "textColor": "#F4F4F5"
  },
  "features": {
    "shields": {
      "name": "BlueNav Shields",
      "enabled": true,
      "blockAds": true,
      "blockTrackers": true,
      "blockFingerprinting": true
    },
    "newTabPage": {
      "style": "minimal",
      "showClock": true,
      "showSearchBar": true,
      "showTopSites": true
    }
  },
  "repository": {
    "github": "https://github.com/acnesia/BlueNav"
  }
}
