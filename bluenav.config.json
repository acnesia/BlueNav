{
  "browserName": "BlueNav",
  "version": "1.0.0",
  "branding": {
    "style": "brave-authentic",
    "primaryColor": "#FB542B",
    "backgroundColorDark": "#1E2029",
    "surfaceColorDark": "#14151F",
    "textColor": "#FFFFFF"
  },
  "features": {
    "shields": {
      "name": "BlueNav Shields",
      "enabled": true,
      "blockAds": true,
      "blockTrackers": true,
      "blockFingerprinting": true
    },
    "ai": {
      "name": "BlueNav AI",
      "enabled": true
    },
    "newTabPage": {
      "style": "brave-standard",
      "showClock": true,
      "showShieldStats": true,
      "showTopSites": true
    }
  },
  "repository": {
    "github": "https://github.com/acnesia/BlueNav"
  }
}
