{
  "name": "bluenav-desktop",
  "version": "1.0.0",
  "description": "BlueNav Browser - Privacy-First AI Super-Browser",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/acnesia/BlueNav.git"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "keywords": [
    "browser",
    "privacy",
    "ai",
    "bluenav",
    "brave",
    "chromium"
  ],
  "author": "acnesia",
  "license": "MPL-2.0",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "publish": null,
    "appId": "com.acnesia.bluenav",
    "productName": "BlueNav",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlueNav"
    }
  }
}
